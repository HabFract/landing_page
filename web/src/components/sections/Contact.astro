---
interface Props {
  headline: string;
  subheadline: string;
  form: {
    nameLabel: string;
    namePlaceholder: string;
    emailLabel: string;
    emailPlaceholder: string;
    messageLabel: string;
    messagePlaceholder: string;
    submitText: string;
    successMessage: string;
    errorMessage: string;
  };
}

const {
  headline = 'Get in Touch',
  subheadline = "Have questions? We'd love to hear from you.",
  form,
} = Astro.props;
---

<section id="contact" class="contact">
  <div class="container">
    <div class="contact__header">
      <h2 class="contact__headline">{headline}</h2>
      {subheadline && <p class="contact__subheadline">{subheadline}</p>}
    </div>

    <div class="contact__content">
      <form class="contact-form" method="POST" action="#contact">
        <div class="contact-form__field">
          <label for="name" class="contact-form__label">
            {form.nameLabel}
          </label>
          <input
            type="text"
            id="name"
            name="name"
            class="contact-form__input"
            placeholder={form.namePlaceholder}
            required
          />
        </div>

        <div class="contact-form__field">
          <label for="email" class="contact-form__label">
            {form.emailLabel}
          </label>
          <input
            type="email"
            id="email"
            name="email"
            class="contact-form__input"
            placeholder={form.emailPlaceholder}
            required
          />
        </div>

        <div class="contact-form__field">
          <label for="message" class="contact-form__label">
            {form.messageLabel}
          </label>
          <textarea
            id="message"
            name="message"
            class="contact-form__textarea"
            placeholder={form.messagePlaceholder}
            required
            rows="5"
          ></textarea>
        </div>

        <input type="submit" class="contact-form__submit" value={form.submitText} />
      </form>
    </div>
  </div>
</section>

<style>
  .contact {
    background: #fafafa;
    padding-top: var(--space-4xl);
    padding-bottom: var(--space-4xl);
  }

  .contact__header {
    text-align: center;
    max-width: 700px;
    margin: 0 auto var(--space-3xl);
  }

  .contact__headline {
    color: var(--color-text-dark);
    font-size: var(--font-size-3xl);
    font-weight: var(--font-weight-bold);
    margin-bottom: var(--space-md);
  }

  .contact__subheadline {
    color: var(--color-text-light);
    font-size: var(--font-size-lg);
    margin: 0;
  }

  .contact__content {
    max-width: 600px;
    margin: 0 auto;
  }

  /* Contact Form Styles */
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
    background: white;
    padding: var(--space-2xl);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
  }

  .contact-form__field {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .contact-form__label {
    color: var(--color-text-dark);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
  }

  .contact-form__input,
  .contact-form__textarea {
    width: 100%;
    padding: var(--space-md);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    font-size: var(--font-size-base);
    font-family: inherit;
    transition: border-color var(--transition-fast);
  }

  .contact-form__input:focus,
  .contact-form__textarea:focus {
    outline: none;
    border-color: var(--color-text-dark);
  }

  .contact-form__textarea {
    resize: vertical;
    min-height: 120px;
  }

  .contact-form__submit {
    background: var(--color-text-dark);
    color: white;
    padding: var(--space-md) var(--space-xl);
    border: none;
    border-radius: var(--radius-full);
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.025em;
    line-height: 1.6;
    cursor: pointer;
    transition: all var(--transition-base);
  }

  .contact-form__submit:hover {
    background: var(--color-text);
    transform: translateY(-1px);
  }

  @media (max-width: 768px) {
    .contact__headline {
      font-size: var(--font-size-2xl);
    }

    .contact-form {
      padding: var(--space-xl);
    }
  }
</style>
