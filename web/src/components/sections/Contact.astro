---
interface Props {
  headline: string;
  subheadline: string;
  form: {
    nameLabel: string;
    namePlaceholder: string;
    emailLabel: string;
    emailPlaceholder: string;
    messageLabel: string;
    messagePlaceholder: string;
    submitText: string;
    successMessage: string;
    errorMessage: string;
  };
}

const {
  headline = 'Get in Touch',
  subheadline = "Have questions? We'd love to hear from you.",
  form,
} = Astro.props;
---

<section id="contact" class="contact">
  <div class="container">
    <div class="contact__header">
      <h2 class="contact__headline">{headline}</h2>
      {subheadline && <p class="contact__subheadline">{subheadline}</p>}
    </div>

    <div class="contact__content">
      <div class="typeform-container" data-tf-live="01KE95YQWG3RMFQ6DS2ZFHJC7Y"></div>
      <script is:inline src="//embed.typeform.com/next/embed.js"></script>
    </div>
  </div>
</section>

<style>
  .contact {
    background: #fafafa;
    padding-top: var(--space-4xl);
    padding-bottom: var(--space-4xl);
  }

  .contact__header {
    text-align: center;
    max-width: 700px;
    margin: 0 auto var(--space-3xl);
  }

  .contact__headline {
    color: var(--color-text-dark);
    font-size: var(--font-size-3xl);
    font-weight: var(--font-weight-bold);
    margin-bottom: var(--space-md);
  }

  .contact__subheadline {
    color: var(--color-text-light);
    font-size: var(--font-size-lg);
    margin: 0;
  }

  .contact__content {
    max-width: 800px;
    margin: 0 auto;
  }

  .typeform-container {
    min-height: 500px;
    width: 100%;
  }

  @media (max-width: 768px) {
    .contact__headline {
      font-size: var(--font-size-2xl);
    }

    .typeform-container {
      min-height: 600px;
    }
  }
</style>
